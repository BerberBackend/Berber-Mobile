# Veritabanı (Railway PostgreSQL bağlantı bilgisi buraya)
DATABASE_URL=postgresql://kullanici:sifre@host:5432/veritabani

# Sunucu
PORT=3000

# SMS Gateway (NetGSM örnek - kendi bilgilerinle değiştir)
SMS_PROVIDER=netgsm
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=

# Deneme sürümü uzunluğu (gün)
TRIAL_DAYS=14

# Varsayılan aylık SMS kotası
DEFAULT_SMS_QUOTA=500
